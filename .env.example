# Copy this file to .env and fill in your real keys.

# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Clerk — https://dashboard.clerk.com → your app → API Keys
CLERK_SECRET_KEY=your_clerk_secret_key_here
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
# Clerk JWKS URL — dashboard.clerk.com → your app → API Keys → show JWKS URL
# Format: https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=your_clerk_jwks_url_here

# Convex — set automatically by `npx convex dev`, or paste from dashboard
VITE_CONVEX_URL=your_convex_url_here

# V2b RAG pipeline — required for retrieval to be active
# Qdrant Cloud — https://cloud.qdrant.io → your cluster → API Keys
QDRANT_URL=your_qdrant_cluster_url_here
QDRANT_API_KEY=your_qdrant_api_key_here
# Voyage AI — https://dash.voyageai.com
VOYAGE_API_KEY=your_voyage_api_key_here
# GitHub — optional, raises API rate limit from 60 to 5000 req/hr (needed for embed_docs.py)
# GITHUB_TOKEN=your_github_token_here
